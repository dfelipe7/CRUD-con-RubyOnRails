<h1>Nuevo Estudiante</h1>


<%= form_with(model: @estudiante, local: true) do |form| %>
  <div>
    <%= form.label :nombre %>
    <%= form.text_field :nombre %>
  </div>

  <div>
    <%= form.label :edad %>
    <%= form.number_field :edad %>
  </div>

  <div>
    <%= form.label :email %>
    <%= form.text_field :email %>
  </div>

  <div class="acciones">
  <%= form.submit "Crear Estudiante", class: "btn btn-primary" %>
  <%= link_to "Volver al Listado", estudiantes_path, class: "btn btn-back" %>
</div>

<% end %>

